# mydrivewaysale.net production (Hostinger, LiteSpeed/Apache). Static Astro build.
# Preview builds (CF_PAGES=1 or PREVIEW=1) delete this file from dist (astro.config.mjs);
# Cloudflare Pages ignores .htaccess anyway and would otherwise serve it as a plain file.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. One hop to https://mydrivewaysale.net for .com (+www), www.net and plain http, path kept.
#    Fixes live's root-only .com redirect that drops to http and serves .com deep URLs as duplicates.
RewriteCond %{HTTP_HOST} ^(www\.)?mydrivewaysale\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.mydrivewaysale\.net$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://mydrivewaysale.net/$1 [R=301,L,NE]

# 2. Gone for good (WordPress endpoints): 410.
RewriteRule ^(wp-admin|wp-includes|wp-json)(/.*)?$ - [G,L]
RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-cron\.php|wp-trackback\.php|wp-links-opml\.php)$ - [G,L]
RewriteRule ^(.*/)?feed/?$ - [G,L]
RewriteCond %{QUERY_STRING} (^|&)rest_route= [NC]
RewriteRule ^ - [G,L]

# 3. Placeholder affiliate URLs Google crawled (e.g. /hub/[INSERT_1800GOTJUNK_AFFILIATE_LINK]) -> parent page.
RewriteRule ^(.*/)?\[INSERT_[A-Za-z0-9_]+\]/?$ https://mydrivewaysale.net/$1 [R=301,L,NE]

# 4. Old WordPress URLs -> closest page.
RewriteRule ^guide/?$ https://mydrivewaysale.net/hub/ [R=301,L]
RewriteRule ^wp-sitemap.*\.xml$ https://mydrivewaysale.net/sitemap-index.xml [R=301,L]
RewriteRule ^author/ https://mydrivewaysale.net/about-contact/ [R=301,L]
RewriteRule ^(hello-world|home)/?$ https://mydrivewaysale.net/ [R=301,L]
RewriteRule ^(category|tag)/ https://mydrivewaysale.net/ [R=301,L]
RewriteRule ^20[0-9]{2}(/.*)?$ https://mydrivewaysale.net/ [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat|author|m)=[0-9]+(&|$) [NC]
RewriteRule ^$ https://mydrivewaysale.net/? [R=301,L]

# 5. Trailing slash on directory pages, straight to https (instead of mod_dir's own redirect).
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ https://mydrivewaysale.net/$1/ [R=301,L]
</IfModule>

# Caching: HTML short so deploys show up fast; static assets 30 days; app service worker never cached.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs|json|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|pdf|wasm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^(flutter_service_worker\.js|flutter_bootstrap\.js|version\.json|manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/manifest+json .webmanifest
</IfModule>
