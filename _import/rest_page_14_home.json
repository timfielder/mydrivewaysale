 Capture -->\n        <div class=\"pseo-footer-right\">\n            <div class=\"pseo-compact-form-wrap\">\n                <h4 class=\"pseo-compact-form-title\">Subscribe for Updates<\/h4>\n                <p style=\"color: #4A7D8F; font-size: 12px; margin: 0;\">Get the latest yard sale regulations, strategies, and app updates.<\/p>\n                <div class=\"pseo-compact-input-group\">\n                    <input type=\"email\" id=\"pseo-footer-email\" class=\"pseo-compact-input\" placeholder=\"Email address\">\n                    <button id=\"pseo-footer-submit\" class=\"pseo-compact-btn\">Join<\/button>\n                <\/div>\n                <p id=\"pseo-footer-msg\" style=\"color: #388E3C; font-size: 12px; font-weight: bold; display: none; margin-top: 8px; margin-bottom: 0;\">Successfully subscribed!<\/p>\n            <\/div>\n        <\/div>\n    <\/div>\n    \n    <script>\n    (function(){\n        const submitBtn = document.getElementById(\"pseo-footer-submit\");\n        const emailInput = document.getElementById(\"pseo-footer-email\");\n        const msgBox = document.getElementById(\"pseo-footer-msg\");\n        if(submitBtn && emailInput) {\n            submitBtn.onclick = function() {\n                let email = emailInput.value.trim();\n                \n                if (email.includes(\"@\") && email.includes(\".\")) {\n                    fetch(\"https:\/\/mydrivewaysale-default-rtdb.firebaseio.com\/drivewaysale_leads.json\", {\n                        method: \"POST\",\n                        body: JSON.stringify({ \n                            email: email, \n                            source: \"Compact Footer Subscribe Form\", \n                            timestamp: new Date().toISOString() \n                        })\n                    }).catch(e => {});\n                    this.innerText = \"\u2713\";\n                    this.style.backgroundColor = \"#388E3C\";\n                    this.style.color = \"white\";\n                    this.disabled = true;\n                    emailInput.disabled = true;\n                    msgBox.style.display = \"block\";\n                } else {\n                    alert(\"Please enter a valid email address.\");\n                }\n            };\n        }\n    })();\n    <\/script>\n    <\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>Everything you need to plan, prep, execute, and survive your driveway sale.<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"elementor_canvas","meta":{"footnotes":""},"class_list":["post-14","page","type-page","status-publish","hentry"],"_hostinger_reach_plugin_has_subscription_block":false,"_hostinger_reach_plugin_is_elementor":false,"_links":{"self":[{"href":"https:\/\/mydrivewaysale.net\/wp-json\/wp\/v2\/pages\/14","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/mydrivewaysale.net\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/mydrivewaysale.net\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/mydrivewaysale.net\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/mydrivewaysale.net\/wp-json\/wp\/v2\/comments?post=14"}],"version-history":[{"count":47,"href":"https:\/\/mydrivewaysale.net\/wp-json\/wp\/v2\/pages\/14\/revisions"}],"predecessor-version":[{"id":748,"href":"https:\/\/mydrivewaysale.net\/wp-json\/wp\/v2\/pages\/14\/revisions\/748"}],"wp:attachment":[{"href":"https:\/\/mydrivewaysale.net\/wp-json\/wp\/v2\/media?parent=14"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}