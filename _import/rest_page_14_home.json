{"id":14,"date":"2026-07-07T12:39:41","date_gmt":"2026-07-07T12:39:41","guid":{"rendered":"https:\/\/mydrivewaysale.net\/?page_id=14"},"modified":"2026-07-14T22:44:51","modified_gmt":"2026-07-14T22:44:51","slug":"home","status":"publish","type":"page","link":"https:\/\/mydrivewaysale.net\/","title":{"rendered":"00 &#8211; Home"},"content":{"rendered":"\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"14\" class=\"elementor elementor-14\">\n\t\t\t\t<div class=\"elementor-element elementor-element-bfb8021 e-con e-atomic-element e-flexbox-base e-default-div e-bfb8021-385a0a5 \" data-id=\"bfb8021\" data-element_type=\"e-flexbox\" data-e-type=\"e-flexbox\" data-interaction-id=\"bfb8021\">\n    \t\t\t<img fetchpriority=\"high\" decoding=\"async\" class=\"e-image-base e-default-img e-491cf0d-cbd1f12\" data-interaction-id=\"491cf0d\" id=\"23\" src=\"https:\/\/mydrivewaysale.net\/wp-content\/uploads\/2026\/07\/MDS-logo-1024x496.png\" width=\"800\" height=\"388\" srcset=\"https:\/\/mydrivewaysale.net\/wp-content\/uploads\/2026\/07\/MDS-logo-1024x496.png 1024w, https:\/\/mydrivewaysale.net\/wp-content\/uploads\/2026\/07\/MDS-logo-300x145.png 300w, https:\/\/mydrivewaysale.net\/wp-content\/uploads\/2026\/07\/MDS-logo-768x372.png 768w, https:\/\/mydrivewaysale.net\/wp-content\/uploads\/2026\/07\/MDS-logo.png 1193w\" alt=\"\"\/>\t\t\n<\/div>\n<div class=\"elementor-element elementor-element-2e38a06 e-con e-atomic-element e-flexbox-base e-default-div e-2e38a06-98d9b68 \" data-id=\"2e38a06\" data-element_type=\"e-flexbox\" data-e-type=\"e-flexbox\" data-interaction-id=\"2e38a06\">\n    \t\t\t<h1 data-interaction-id=\"7230eae\" class=\"e-7230eae-97b32b1 e-heading-base e-default-h1\">Everything you need to plan, prep, execute, and survive your driveway sale.<\/h1>\n\t\t\n<\/div>\n<div class=\"elementor-element elementor-element-5203914 e-flex e-con-boxed e-con e-parent\" data-id=\"5203914\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-ac7eafd elementor-widget elementor-widget-shortcode\" data-id=\"ac7eafd\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"shortcode.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-shortcode\">\n    <style>\n        .pseo-search-container { position: relative; max-width: 600px; margin: 0 auto; text-align: left; font-family: \"Roboto\", sans-serif; }\n        .pseo-search-input { width: 100%; padding: 18px 20px; font-size: 16px; border: 2px solid #4A7D8F; border-radius: 8px; box-sizing: border-box; color: #00264C; outline: none; transition: all 0.3s ease; }\n        .pseo-search-input:focus { border-color: #E0B42D; box-shadow: 0 4px 15px rgba(0,38,76,0.1); }\n        .pseo-results-box { position: absolute; top: 100%; left: 0; right: 0; background: #ffffff; border: 2px solid #E0B42D; border-top: none; border-radius: 0 0 8px 8px; max-height: 280px; overflow-y: auto; z-index: 1000; box-shadow: 0 15px 30px rgba(0,38,76,0.15); display: none; }\n        .pseo-result-item { padding: 15px 20px; cursor: pointer; color: #00264C; border-bottom: 1px solid #f0f0f0; transition: background-color 0.2s; }\n        .pseo-result-item:hover { background-color: #F5F7FA; color: #4A7D8F; font-weight: bold; }\n        \n        \/* Modal Styles *\/\n        .pseo-modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 38, 76, 0.7); z-index: 9999; justify-content: center; align-items: center; padding: 20px; box-sizing: border-box; backdrop-filter: blur(4px); }\n        .pseo-modal-box { background: white; padding: 30px; border-radius: 12px; width: 100%; max-width: 450px; text-align: center; box-shadow: 0 15px 35px rgba(0,0,0,0.2); border-top: 5px solid #E0B42D; font-family: \"Roboto\", sans-serif; }\n        .pseo-modal-btn { background-color: #4A7D8F; color: white; border: none; padding: 15px; border-radius: 8px; font-weight: bold; width: 100%; font-size: 15px; cursor: pointer; margin-top: 15px; }\n        .pseo-modal-btn-alt { background-color: transparent; color: #4A7D8F; border: 2px solid #4A7D8F; padding: 13px; border-radius: 8px; font-weight: bold; width: 100%; font-size: 15px; cursor: pointer; margin-top: 10px; }\n    <\/style>\n\n    <div style=\"background-color: #F5F7FA; padding: 40px 30px; border-radius: 12px; border: 2px solid #4A7D8F; text-align: center; max-width: 600px; margin: 0 auto;\">\n        <h3 style=\"color: #00264C; font-family: 'Montserrat', sans-serif; margin-top: 0; font-size: 22px;\">Find Your Local Driveway Sale Hub<\/h3>\n        <p style=\"color: #4A7D8F; font-family: 'Roboto', sans-serif; font-size: 14px; margin-bottom: 25px;\">Search your city to compile your local regulations.<\/p>\n\n        <div class=\"pseo-search-container\">\n            <input type=\"text\" id=\"pseo-city-input\" class=\"pseo-search-input\" placeholder=\"Search USA (e.g., Amarillo, TX)...\" autocomplete=\"off\">\n            <div id=\"pseo-results\" class=\"pseo-results-box\"><\/div>\n            <button id=\"pseo-submit-btn\" style=\"background-color: #E0B42D; color: #00264C; border: none; padding: 18px 25px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 16px; width: 100%; margin-top: 15px;\">Go To My Local Guide<\/button>\n        <\/div>\n    <\/div>\n\n    <!-- THE AMARILLO TRAP MODAL -->\n    <div id=\"pseo-modal\" class=\"pseo-modal-overlay\">\n        <div class=\"pseo-modal-box\">\n            <h3 style=\"color: #00264C; font-family: 'Montserrat', sans-serif; margin-top: 0; font-size: 20px;\">Location Pending<\/h3>\n            <p style=\"color: #4A7D8F; font-size: 15px; line-height: 1.5; margin-bottom: 20px;\">\n                <strong><span id=\"modal-city\"><\/span>, <span id=\"modal-state-code\"><\/span><\/strong> has not been added to our location registry yet. We just submitted an automated request to our team to build your local guide!\n            <\/p>\n            <div style=\"background-color: #F5F7FA; padding: 20px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #E1E8ED;\">\n                <p style=\"margin-top: 0; font-size: 13px; color: #00264C; font-weight: bold;\">Submit your email to be notified the second it is compiled:<\/p>\n                <input type=\"email\" id=\"pseo-email-input\" placeholder=\"Enter your email address\" style=\"width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; margin-bottom: 10px;\">\n                <button id=\"pseo-email-submit\" style=\"background-color: #00264C; color: white; border: none; padding: 12px; width: 100%; border-radius: 4px; font-weight: bold; cursor: pointer;\">NOTIFY ME<\/button>\n            <\/div>\n            <p style=\"color: #4A7D8F; font-size: 13px; line-height: 1.5;\">In the meantime, you can view the general <span id=\"modal-state-full\"><\/span> guide, or select a different city.<\/p>\n            <button id=\"modal-state-btn\" class=\"pseo-modal-btn\">View General <span id=\"modal-state-btn-text\"><\/span> Guide<\/button>\n            <button onclick=\"document.getElementById('pseo-modal').style.display='none';\" class=\"pseo-modal-btn-alt\">Select A Different City<\/button>\n        <\/div>\n    <\/div>\n\n    <script>\n    (function(){\n        const supportedCities = [{\"city\":\"san antonio\",\"state\":\"tx\",\"slug\":\"san-antonio-tx-garage-sale-guide\"},{\"city\":\"austin\",\"state\":\"tx\",\"slug\":\"austin-tx-garage-sale-guide\"},{\"city\":\"houston\",\"state\":\"tx\",\"slug\":\"houston-tx-garage-sale-guide\"},{\"city\":\"dallas\",\"state\":\"tx\",\"slug\":\"dallas-tx-garage-sale-guide\"},{\"city\":\"fort worth\",\"state\":\"tx\",\"slug\":\"fort-worth-tx-garage-sale-guide\"},{\"city\":\"el paso\",\"state\":\"tx\",\"slug\":\"el-paso-tx-garage-sale-guide\"},{\"city\":\"arlington\",\"state\":\"tx\",\"slug\":\"arlington-tx-garage-sale-guide\"},{\"city\":\"corpus christi\",\"state\":\"tx\",\"slug\":\"corpus-christi-tx-garage-sale-guide\"},{\"city\":\"phoenix\",\"state\":\"az\",\"slug\":\"phoenix-az-garage-sale-guide\"},{\"city\":\"tucson\",\"state\":\"az\",\"slug\":\"tucson-az-garage-sale-guide\"},{\"city\":\"mesa\",\"state\":\"az\",\"slug\":\"mesa-az-garage-sale-guide\"},{\"city\":\"chandler\",\"state\":\"az\",\"slug\":\"chandler-az-garage-sale-guide\"},{\"city\":\"los angeles\",\"state\":\"ca\",\"slug\":\"los-angeles-ca-garage-sale-guide\"},{\"city\":\"san diego\",\"state\":\"ca\",\"slug\":\"san-diego-ca-garage-sale-guide\"},{\"city\":\"san jose\",\"state\":\"ca\",\"slug\":\"san-jose-ca-garage-sale-guide\"},{\"city\":\"san francisco\",\"state\":\"ca\",\"slug\":\"san-francisco-ca-garage-sale-guide\"},{\"city\":\"fresno\",\"state\":\"ca\",\"slug\":\"fresno-ca-garage-sale-guide\"},{\"city\":\"sacramento\",\"state\":\"ca\",\"slug\":\"sacramento-ca-garage-sale-guide\"},{\"city\":\"long beach\",\"state\":\"ca\",\"slug\":\"long-beach-ca-garage-sale-guide\"},{\"city\":\"oakland\",\"state\":\"ca\",\"slug\":\"oakland-ca-garage-sale-guide\"},{\"city\":\"bakersfield\",\"state\":\"ca\",\"slug\":\"bakersfield-ca-garage-sale-guide\"},{\"city\":\"anaheim\",\"state\":\"ca\",\"slug\":\"anaheim-ca-garage-sale-guide\"},{\"city\":\"seattle\",\"state\":\"wa\",\"slug\":\"seattle-wa-garage-sale-guide\"},{\"city\":\"spokane\",\"state\":\"wa\",\"slug\":\"spokane-wa-garage-sale-guide\"},{\"city\":\"tacoma\",\"state\":\"wa\",\"slug\":\"tacoma-wa-garage-sale-guide\"},{\"city\":\"portland\",\"state\":\"or\",\"slug\":\"portland-or-garage-sale-guide\"},{\"city\":\"salem\",\"state\":\"or\",\"slug\":\"salem-or-garage-sale-guide\"},{\"city\":\"las vegas\",\"state\":\"nv\",\"slug\":\"las-vegas-nv-garage-sale-guide\"},{\"city\":\"henderson\",\"state\":\"nv\",\"slug\":\"henderson-nv-garage-sale-guide\"},{\"city\":\"reno\",\"state\":\"nv\",\"slug\":\"reno-nv-garage-sale-guide\"},{\"city\":\"denver\",\"state\":\"co\",\"slug\":\"denver-co-garage-sale-guide\"},{\"city\":\"colorado springs\",\"state\":\"co\",\"slug\":\"colorado-springs-co-garage-sale-guide\"},{\"city\":\"aurora\",\"state\":\"co\",\"slug\":\"aurora-co-garage-sale-guide\"},{\"city\":\"oklahoma city\",\"state\":\"ok\",\"slug\":\"oklahoma-city-ok-garage-sale-guide\"},{\"city\":\"tulsa\",\"state\":\"ok\",\"slug\":\"tulsa-ok-garage-sale-guide\"},{\"city\":\"salt lake city\",\"state\":\"ut\",\"slug\":\"salt-lake-city-ut-garage-sale-guide\"},{\"city\":\"chicago\",\"state\":\"il\",\"slug\":\"chicago-il-garage-sale-guide\"},{\"city\":\"aurora\",\"state\":\"il\",\"slug\":\"aurora-il-garage-sale-guide\"},{\"city\":\"joliet\",\"state\":\"il\",\"slug\":\"joliet-il-garage-sale-guide\"},{\"city\":\"naperville\",\"state\":\"il\",\"slug\":\"naperville-il-garage-sale-guide\"},{\"city\":\"detroit\",\"state\":\"mi\",\"slug\":\"detroit-mi-garage-sale-guide\"},{\"city\":\"grand rapids\",\"state\":\"mi\",\"slug\":\"grand-rapids-mi-garage-sale-guide\"},{\"city\":\"warren\",\"state\":\"mi\",\"slug\":\"warren-mi-garage-sale-guide\"},{\"city\":\"columbus\",\"state\":\"oh\",\"slug\":\"columbus-oh-garage-sale-guide\"},{\"city\":\"cleveland\",\"state\":\"oh\",\"slug\":\"cleveland-oh-garage-sale-guide\"},{\"city\":\"cincinnati\",\"state\":\"oh\",\"slug\":\"cincinnati-oh-garage-sale-guide\"},{\"city\":\"toledo\",\"state\":\"oh\",\"slug\":\"toledo-oh-garage-sale-guide\"},{\"city\":\"indianapolis\",\"state\":\"in\",\"slug\":\"indianapolis-in-garage-sale-guide\"},{\"city\":\"fort wayne\",\"state\":\"in\",\"slug\":\"fort-wayne-in-garage-sale-guide\"},{\"city\":\"minneapolis\",\"state\":\"mn\",\"slug\":\"minneapolis-mn-garage-sale-guide\"},{\"city\":\"st. paul\",\"state\":\"mn\",\"slug\":\"st.-paul-mn-garage-sale-guide\"},{\"city\":\"kansas city\",\"state\":\"mo\",\"slug\":\"kansas-city-mo-garage-sale-guide\"},{\"city\":\"st. louis\",\"state\":\"mo\",\"slug\":\"st.-louis-mo-garage-sale-guide\"},{\"city\":\"omaha\",\"state\":\"ne\",\"slug\":\"omaha-ne-garage-sale-guide\"},{\"city\":\"lincoln\",\"state\":\"ne\",\"slug\":\"lincoln-ne-garage-sale-guide\"},{\"city\":\"des moines\",\"state\":\"ia\",\"slug\":\"des-moines-ia-garage-sale-guide\"},{\"city\":\"wichita\",\"state\":\"ks\",\"slug\":\"wichita-ks-garage-sale-guide\"},{\"city\":\"fargo\",\"state\":\"nd\",\"slug\":\"fargo-nd-garage-sale-guide\"},{\"city\":\"sioux falls\",\"state\":\"sd\",\"slug\":\"sioux-falls-sd-garage-sale-guide\"},{\"city\":\"boise\",\"state\":\"id\",\"slug\":\"boise-id-garage-sale-guide\"},{\"city\":\"atlanta\",\"state\":\"ga\",\"slug\":\"atlanta-ga-yard-sale-guide\"},{\"city\":\"augusta\",\"state\":\"ga\",\"slug\":\"augusta-ga-yard-sale-guide\"},{\"city\":\"miami\",\"state\":\"fl\",\"slug\":\"miami-fl-yard-sale-guide\"},{\"city\":\"tampa\",\"state\":\"fl\",\"slug\":\"tampa-fl-yard-sale-guide\"},{\"city\":\"orlando\",\"state\":\"fl\",\"slug\":\"orlando-fl-yard-sale-guide\"},{\"city\":\"jacksonville\",\"state\":\"fl\",\"slug\":\"jacksonville-fl-yard-sale-guide\"},{\"city\":\"st. petersburg\",\"state\":\"fl\",\"slug\":\"st.-petersburg-fl-yard-sale-guide\"},{\"city\":\"charlotte\",\"state\":\"nc\",\"slug\":\"charlotte-nc-yard-sale-guide\"},{\"city\":\"raleigh\",\"state\":\"nc\",\"slug\":\"raleigh-nc-yard-sale-guide\"},{\"city\":\"greensboro\",\"state\":\"nc\",\"slug\":\"greensboro-nc-yard-sale-guide\"},{\"city\":\"durham\",\"state\":\"nc\",\"slug\":\"durham-nc-yard-sale-guide\"},{\"city\":\"nashville\",\"state\":\"tn\",\"slug\":\"nashville-tn-yard-sale-guide\"},{\"city\":\"memphis\",\"state\":\"tn\",\"slug\":\"memphis-tn-yard-sale-guide\"},{\"city\":\"knoxville\",\"state\":\"tn\",\"slug\":\"knoxville-tn-yard-sale-guide\"},{\"city\":\"louisville\",\"state\":\"ky\",\"slug\":\"louisville-ky-yard-sale-guide\"},{\"city\":\"lexington\",\"state\":\"ky\",\"slug\":\"lexington-ky-yard-sale-guide\"},{\"city\":\"washington\",\"state\":\"dc\",\"slug\":\"washington-dc-yard-sale-guide\"},{\"city\":\"baltimore\",\"state\":\"md\",\"slug\":\"baltimore-md-yard-sale-guide\"},{\"city\":\"richmond\",\"state\":\"va\",\"slug\":\"richmond-va-yard-sale-guide\"},{\"city\":\"virginia beach\",\"state\":\"va\",\"slug\":\"virginia-beach-va-yard-sale-guide\"},{\"city\":\"philadelphia\",\"state\":\"pa\",\"slug\":\"philadelphia-pa-yard-sale-guide\"},{\"city\":\"pittsburgh\",\"state\":\"pa\",\"slug\":\"pittsburgh-pa-yard-sale-guide\"},{\"city\":\"allentown\",\"state\":\"pa\",\"slug\":\"allentown-pa-yard-sale-guide\"},{\"city\":\"new york city\",\"state\":\"ny\",\"slug\":\"new-york-city-ny-yard-sale-guide\"},{\"city\":\"buffalo\",\"state\":\"ny\",\"slug\":\"buffalo-ny-yard-sale-guide\"},{\"city\":\"newark\",\"state\":\"nj\",\"slug\":\"newark-nj-yard-sale-guide\"},{\"city\":\"jersey city\",\"state\":\"nj\",\"slug\":\"jersey-city-nj-yard-sale-guide\"},{\"city\":\"boston\",\"state\":\"ma\",\"slug\":\"boston-ma-yard-sale-guide\"},{\"city\":\"worcester\",\"state\":\"ma\",\"slug\":\"worcester-ma-yard-sale-guide\"},{\"city\":\"providence\",\"state\":\"ri\",\"slug\":\"providence-ri-yard-sale-guide\"},{\"city\":\"milwaukee\",\"state\":\"wi\",\"slug\":\"milwaukee-wi-rummage-sale-guide\"},{\"city\":\"madison\",\"state\":\"wi\",\"slug\":\"madison-wi-rummage-sale-guide\"},{\"city\":\"green bay\",\"state\":\"wi\",\"slug\":\"green-bay-wi-rummage-sale-guide\"},{\"city\":\"kenosha\",\"state\":\"wi\",\"slug\":\"kenosha-wi-rummage-sale-guide\"},{\"city\":\"racine\",\"state\":\"wi\",\"slug\":\"racine-wi-rummage-sale-guide\"},{\"city\":\"hartford\",\"state\":\"ct\",\"slug\":\"hartford-ct-tag-sale-guide\"},{\"city\":\"new haven\",\"state\":\"ct\",\"slug\":\"new-haven-ct-tag-sale-guide\"},{\"city\":\"stamford\",\"state\":\"ct\",\"slug\":\"stamford-ct-tag-sale-guide\"},{\"city\":\"bridgeport\",\"state\":\"ct\",\"slug\":\"bridgeport-ct-tag-sale-guide\"},{\"city\":\"springfield\",\"state\":\"ma\",\"slug\":\"springfield-ma-tag-sale-guide\"}];\n        const input = document.getElementById(\"pseo-city-input\");\n        const resultsBox = document.getElementById(\"pseo-results\");\n        const submitBtn = document.getElementById(\"pseo-submit-btn\");\n\n        let typingTimer;\n        let selectedCity = \"\";\n        let selectedState = \"\";\n        let selectedCountryCode = \"\";\n\n        const stateMap = {\"Alabama\":\"AL\",\"Alaska\":\"AK\",\"Arizona\":\"AZ\",\"Arkansas\":\"AR\",\"California\":\"CA\",\"Colorado\":\"CO\",\"Connecticut\":\"CT\",\"Delaware\":\"DE\",\"Florida\":\"FL\",\"Georgia\":\"GA\",\"Hawaii\":\"HI\",\"Idaho\":\"ID\",\"Illinois\":\"IL\",\"Indiana\":\"IN\",\"Iowa\":\"IA\",\"Kansas\":\"KS\",\"Kentucky\":\"KY\",\"Louisiana\":\"LA\",\"Maine\":\"ME\",\"Maryland\":\"MD\",\"Massachusetts\":\"MA\",\"Michigan\":\"MI\",\"Minnesota\":\"MN\",\"Mississippi\":\"MS\",\"Missouri\":\"MO\",\"Montana\":\"MT\",\"Nebraska\":\"NE\",\"Nevada\":\"NV\",\"New Hampshire\":\"NH\",\"New Jersey\":\"NJ\",\"New Mexico\":\"NM\",\"New York\":\"NY\",\"North Carolina\":\"NC\",\"North Dakota\":\"ND\",\"Ohio\":\"OH\",\"Oklahoma\":\"OK\",\"Oregon\":\"OR\",\"Pennsylvania\":\"PA\",\"Rhode Island\":\"RI\",\"South Carolina\":\"SC\",\"South Dakota\":\"SD\",\"Tennessee\":\"TN\",\"Texas\":\"TX\",\"Utah\":\"UT\",\"Vermont\":\"VT\",\"Virginia\":\"VA\",\"Washington\":\"WA\",\"West Virginia\":\"WV\",\"Wisconsin\":\"WI\",\"Wyoming\":\"WY\",\"District of Columbia\":\"DC\"};\n\n\t\t\/\/ External Validation: Open-Meteo Geocoding API\n\t\tinput.addEventListener(\"input\", function() {\n\t\t\tclearTimeout(typingTimer);\n\t\t\tselectedCity = \"\"; \/\/ Reset validation\n\n\t\t\tconst query = this.value.trim();\n\t\t\tif (query.length < 3) { resultsBox.style.display = \"none\"; return; }\n\n\t\t\ttypingTimer = setTimeout(() => {\n\t\t\t\t\/\/ Increased count to 15 to ensure we catch the US city if buried under global results\n\t\t\t\tfetch(`https:\/\/geocoding-api.open-meteo.com\/v1\/search?name=${encodeURIComponent(query)}&count=15&language=en&format=json`)\n\t\t\t\t\t.then(res => res.json())\n\t\t\t\t\t.then(data => {\n\t\t\t\t\t\tresultsBox.innerHTML = \"\";\n\t\t\t\t\t\tif (data.results && data.results.length > 0) {\n\t\t\t\t\t\t\t\/\/ STRICT USA FILTER: Only keep US cities, and slice to show only the top 5\n\t\t\t\t\t\t\tlet usResults = data.results.filter(res => res.country_code === \"US\").slice(0, 5);\n\n\t\t\t\t\t\t\tusResults.forEach(res => {\n\t\t\t\t\t\t\t\tlet locName = res.name;\n\t\t\t\t\t\t\t\tlet region = res.admin1 ? res.admin1 : res.country;\n\t\t\t\t\t\t\t\tlet div = document.createElement(\"div\");\n\t\t\t\t\t\t\t\tdiv.className = \"pseo-result-item\";\n\t\t\t\t\t\t\t\tdiv.innerHTML = `<strong>${locName}<\/strong>, ${region}`;\n\t\t\t\t\t\t\t\tdiv.onclick = function() {\n\t\t\t\t\t\t\t\t\tselectedCity = res.name;\n\t\t\t\t\t\t\t\t\tselectedState = res.admin1 || \"\";\n\t\t\t\t\t\t\t\t\tselectedCountryCode = res.country_code || \"\";\n\t\t\t\t\t\t\t\t\tinput.value = `${locName}, ${region}`;\n\t\t\t\t\t\t\t\t\tresultsBox.style.display = \"none\";\n\t\t\t\t\t\t\t\t};\n\t\t\t\t\t\t\t\tresultsBox.appendChild(div);\n\t\t\t\t\t\t\t});\n\t\t\t\t\t\t\tresultsBox.style.display = \"block\";\n\t\t\t\t\t\t}\n\t\t\t\t\t}).catch(e => console.log(e));\n\t\t\t}, 300);\n\t\t});\n\n        document.addEventListener(\"click\", function(e) {\n            if (e.target !== input && e.target !== resultsBox) resultsBox.style.display = \"none\";\n        });\n\n        \/\/ The Routing Engine\n        submitBtn.onclick = function() {\n            if (!selectedCity) {\n                alert(\"Please select a valid location from the dropdown suggestions first.\");\n                return;\n            }\n\n            \/\/ Global Fallback (South Africa Problem Solved!)\n            if (selectedCountryCode !== \"US\") {\n                window.location.href = \"\/international-garage-sale-guide\/\";\n                return;\n            }\n\n            let stateCode = stateMap[selectedState] || \"\";\n            let match = supportedCities.find(c => c.city === selectedCity.toLowerCase() && c.state === stateCode.toLowerCase());\n\n            if (match) {\n                \/\/ Happy Path: Match Found\n                window.location.href = \"\/\" + match.slug + \"\/\";\n            } else {\n                \/\/ The Amarillo Trap: No Match Found!\n                \n                \/\/ 1. Silently log the missing city demand to your newly siloed Firebase\n                fetch(\"https:\/\/mydrivewaysale-default-rtdb.firebaseio.com\/drivewaysale_requests.json\", {\n                    method: \"POST\",\n                    body: JSON.stringify({ city: selectedCity, state: stateCode, timestamp: new Date().toISOString() })\n                }).catch(e => {});\n\n                \/\/ 2. Populate and display the Modal\n                document.getElementById(\"modal-city\").innerText = selectedCity;\n                document.getElementById(\"modal-state-code\").innerText = stateCode;\n                document.getElementById(\"modal-state-full\").innerText = selectedState;\n                document.getElementById(\"modal-state-btn-text\").innerText = selectedState;\n\n                \/\/ Create the safe General State Route (e.g., \/general-texas-garage-sale-guide\/)\n                let stateSlug = \"general-\" + selectedState.toLowerCase().replace(\/\\s+\/g, \"-\") + \"-garage-sale-guide\";\n                document.getElementById(\"modal-state-btn\").onclick = function() {\n                    window.location.href = \"\/\" + stateSlug + \"\/\";\n                };\n\n                document.getElementById(\"pseo-modal\").style.display = \"flex\";\n            }\n        };\n\n        \/\/ Email Lead Collection Submission\n        document.getElementById(\"pseo-email-submit\").onclick = function() {\n            let email = document.getElementById(\"pseo-email-input\").value;\n            if (email.includes(\"@\")) {\n                \/\/ Sent safely to your newly siloed Firebase!\n                fetch(\"https:\/\/mydrivewaysale-default-rtdb.firebaseio.com\/drivewaysale_leads.json\", {\n                    method: \"POST\",\n                    body: JSON.stringify({ email: email, city: selectedCity, state: stateMap[selectedState] || \"\", timestamp: new Date().toISOString() })\n                }).catch(e => {});\n                \n                this.innerText = \"Subscribed!\";\n                this.style.backgroundColor = \"#388E3C\";\n                this.disabled = true;\n            } else {\n                alert(\"Please enter a valid email address.\");\n            }\n        };\n    })();\n    <\/script>\n    <\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-52d898d e-con e-atomic-element e-flexbox-base e-default-div \" data-id=\"52d898d\" data-element_type=\"e-flexbox\" data-e-type=\"e-flexbox\" data-interaction-id=\"52d898d\">\n    \t\t\t\n<hr class=\"e-divider-base\" data-interaction-id=\"ef2e20e\" \/>\n\t\t\n<\/div>\n<div class=\"elementor-element elementor-element-60884ca e-flex e-con-boxed e-con e-parent\" data-id=\"60884ca\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-924e24f elementor-widget elementor-widget-shortcode\" data-id=\"924e24f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"shortcode.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-shortcode\">    <style>\n        \/* Global Structural Wrap with Protective Buffer Shading *\/\n        .pseo-footer-wrap { \n            background-color: #ffffff; \n            padding: 40px 5% 24px 5%;\n            border-top: 5px solid #00264C; \n            display: flex; \n            flex-wrap: wrap; \n            justify-content: space-between; \n            align-items: flex-start; \n            font-family: 'Roboto', sans-serif; \n            gap: 30px; \n\t\t\twidth: 100%; \/* FORCES FOOTER TO FULL WIDTH *\/\n   \t\t \tclear: both; \/* STOPS IT FROM FLOATING NEXT TO MAIN CONTENT *\/\n    \t\tbox-sizing: border-box;\n            position: relative;\n          