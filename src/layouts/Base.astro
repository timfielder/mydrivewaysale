---
import { SITE_URL, SITE_NAME } from '../lib/site-config.mjs';
import { withSiteName } from '../lib/titles.mjs';
import AdSenseLoader from '../components/AdSenseLoader.astro';
// canvas: page draws its own full layout (no default header, footer, or base styles), like the
// live WordPress pages built on the Elementor Canvas template (the homepage).
interface Props { title: string; description: string; canonicalPath?: string | null; noindex?: boolean; pageType?: string; canvas?: boolean; bodyClass?: string; }
const { title, description, canonicalPath = Astro.url.pathname, noindex = false, pageType = 'legal', canvas = false, bodyClass = 'elementor-kit-6' } = Astro.props;
const canonical = canonicalPath ? new URL(canonicalPath, SITE_URL).href : null;
const fullTitle = withSiteName(title);
// Google tag: production (Hostinger) builds only. Cloudflare Pages preview builds (CF_PAGES=1) and
// PREVIEW=1 builds leave it out so preview visits don't count (approved difference 7).
// Markup copied from live WordPress (Site Kit output, checked 2026-11-17).
const IS_PREVIEW = process.env.CF_PAGES === '1' || process.env.PREVIEW === '1';
const GTAG_ID = 'GT-5TGL39GM';
const GTAG_INLINE = `
window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}
gtag("set","linker",{"domains":["mydrivewaysale.net"]});
gtag("js", new Date());
gtag("set", "developer_id.dZTNiMT", true);
gtag("config", "${GTAG_ID}");
 window._googlesitekit = window._googlesitekit || {}; window._googlesitekit.throttledEvents = []; window._googlesitekit.gtagEvent = (name, data) => { var key = JSON.stringify( { name, data } ); if ( !! window._googlesitekit.throttledEvents[ key ] ) { return; } window._googlesitekit.throttledEvents[ key ] = true; setTimeout( () => { delete window._googlesitekit.throttledEvents[ key ]; }, 5 ); gtag( "event", name, { ...data, event_source: "site-kit" } ); }; 
`;
const BASE_CSS = `
      body { font-family: system-ui, sans-serif; max-width: 52rem; margin: 0 auto; padding: 1rem; color: #00264C; line-height: 1.5; }
      a { color: #1a5d8f; }
      table { border-collapse: collapse; width: 100%; }
      th, td { text-align: left; padding: .5rem; border-bottom: 1px solid #E2E8F0; vertical-align: top; }
      .badge { display: inline-block; padding: .1rem .5rem; border-radius: 4px; font-size: .85rem; }
      .verified { background: #E6F4EA; color: #137333; }
      .unverified { background: #FFF4E5; color: #8a4b00; }
      header nav a, footer a { margin-right: 1rem; }
      .picks, .promo { border: 1px solid #E2E8F0; border-radius: 12px; padding: .75rem 1rem; margin: 1.5rem 0; background: #F8FAFC; }
      .picks h3, .promo h3 { margin-top: .25rem; }
      .promo-stickercalc { border: 2px solid #00264C; }
      .btn { display: inline-block; background: #E0B42D; color: #00264C; padding: .5rem .9rem; border-radius: 6px; font-weight: 600; text-decoration: none; margin: 0 .5rem .5rem 0; }
      .ad { margin: 1.5rem 0; text-align: center; }
      .ad-label { display: block; font-size: .7rem; color: #718096; text-transform: uppercase; letter-spacing: .05em; }
`;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/wp-content/uploads/2026/07/MDS-favicon-150x150.png" sizes="32x32" />
    <link rel="icon" href="/wp-content/uploads/2026/07/MDS-favicon-300x300.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2026/07/MDS-favicon-300x300.png" />
    {!IS_PREVIEW && <script is:inline id="google_gtagjs-js" src={`https://www.googletagmanager.com/gtag/js?id=${GTAG_ID}`} async></script>}
    {!IS_PREVIEW && <script is:inline id="google_gtagjs-js-after" set:html={GTAG_INLINE}></script>}
    <slot name="head" />
    <AdSenseLoader pageType={pageType} noindex={noindex} />
    {!canvas && <style is:inline set:html={BASE_CSS}></style>}
  </head>
  {canvas ? (
  <body class={bodyClass}>
    <slot />
  </body>
  ) : (
  <body>
    <header><nav><a href="/">My Driveway Sale</a><a href="/hub/">City guides</a><a href="/stickercalc-app/">StickerCalc</a><a href="/about-contact/">About</a></nav></header>
    <main><slot /></main>
    <footer>
      <p><small>Rules change. Always confirm with your city before your sale. <a href="/privacy-policy/">Privacy</a><a href="/terms-of-service/">Terms</a></small></p>
      <p><small>Some links on this site are affiliate links. As an Amazon Associate, My Driveway Sale earns from qualifying purchases, at no extra cost to you.</small></p>
    </footer>
  </body>
  )}
</html>
