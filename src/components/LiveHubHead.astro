---
// <head> assets of the live hub template (page 392), in live load order, copied from
// https://mydrivewaysale.net on 2026-11-17 to the same paths (version query strings dropped).
// Live's inline head styles (WP global styles, Elementor inline CSS) are in /_live/hub-head.css.
const css = [
  'plugins/hostinger-reach/frontend/dist/blocks/subscription.css',
  'plugins/pojo-accessibility/assets/build/skip-link.css',
  'themes/hello-elementor/assets/css/reset.css',
  'themes/hello-elementor/assets/css/theme.css',
  'themes/hello-elementor/assets/css/header-footer.css',
  'plugins/elementor/assets/css/frontend.min.css',
  'uploads/elementor/css/post-6.css',
  'plugins/elementor/assets/css/widget-icon-list.min.css',
  'uploads/elementor/css/post-392.css',
  'uploads/elementor/css/base-desktop.css',
  'uploads/elementor/css/local-392-frontend-desktop.css',
];
const mobile = ['uploads/elementor/css/base-mobile.css', 'uploads/elementor/css/local-392-frontend-mobile.css'];
const fonts = ['Roboto', 'Roboto+Slab', 'Montserrat'];
const w = '100,100italic,200,200italic,300,300italic,400,400italic,500,500italic,600,600italic,700,700italic,800,800italic,900,900italic';
---
<link rel="stylesheet" href="/_live/hub-head.css" media="all" />
{css.map((h) => <link rel="stylesheet" href={`/wp-content/${h}`} media="all" />)}
{mobile.map((h) => <link rel="stylesheet" href={`/wp-content/${h}`} media="(max-width:767px)" />)}
{fonts.map((f) => <link rel="stylesheet" href={`https://fonts.googleapis.com/css?family=${f}:${w}&display=swap`} media="all" />)}
